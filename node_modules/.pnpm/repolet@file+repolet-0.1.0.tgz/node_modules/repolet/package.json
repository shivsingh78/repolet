{
  "name": "repolet",
  "version": "0.1.0",
  "description": "Copy a complete GitHub repository or a specific folder directly to your local filesystem",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "repolet": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "github",
    "git",
    "clone",
    "github-folder",
    "repository",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "scripts": {
    "start": "node src/index.js"
  }
}